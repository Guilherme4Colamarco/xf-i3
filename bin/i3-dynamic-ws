#!/usr/bin/env bash
# i3-dynamic-ws: GNOME/niri-style dynamic workspaces.
#
# Keeps numbered workspaces 1..9 contiguous without gaps: when one empties
# and disappears, subsequent ones shift down by one; a workspace created out
# of order (e.g. Super+7 when only 3 exist) becomes the next in line. Names
# that are not plain numbers (e.g. "10:free") are ignored and left untouched.
# Keybindings live in ~/.local/bin/i3-ws. Started by XFCE:
# ~/.config/autostart/i3-dynamic-ws.desktop
set -uo pipefail

# Only runs when the session is using i3
[[ "${RICE_WM:-}" == "xfwm4" ]] && exit 0
pgrep -x -u "$UID" xfwm4 >/dev/null && exit 0

normalize() {
    local i=1 n
    while IFS= read -r n; do
        [[ "$n" != "$i" ]] && i3-msg -q "rename workspace \"$n\" to \"$i\""
        ((i++))
    done < <(i3-msg -t get_workspaces | jq -r '
        [.[] | select(.name | test("^[0-9]+$")) | select(.num >= 1 and .num <= 9)]
        | sort_by(.num) | .[].name')
}

fails=0
while :; do
    if pgrep -x -u "$UID" i3 >/dev/null; then
        fails=0
        normalize
        i3-msg -t subscribe -m '["workspace"]' 2>/dev/null |
            while read -r ev; do
                case "$ev" in
                    *'"change":"empty"'*|*'"change":"init"'*|*'"change":"move"'*) normalize ;;
                esac
            done
    fi
    ((++fails > 60)) && exit 0
    sleep 1
done
