#!/usr/bin/env bash
# i3-xfce-wsnames: mantém os nomes de workspace do XFCE iguais aos do i3.
#
# O xfsettingsd (workspaces.c) publica _NET_DESKTOP_NAMES a partir de
# xfconf xfwm4:/general/workspace_names e sobrescreve o que o i3 escreve,
# então o pager do painel mostraria "Espaço de trabalho N". Este serviço
# escuta os eventos de workspace do i3 e copia a lista de nomes, na ordem,
# para esse xfconf; o xfsettingsd então publica os nomes certos.
# Iniciado pelo XFCE: ~/.config/autostart/i3-xfce-wsnames.desktop
set -uo pipefail

sync_names() {
    local args=() n
    while IFS= read -r n; do args+=(-t string -s "$n"); done < <(i3-msg -t get_workspaces | jq -r '.[].name')
    ((${#args[@]})) || return 0
    xfconf-query -c xfwm4 -p /general/workspace_names -n --force-array "${args[@]}"
}

fails=0
while :; do
    if pgrep -x -u "$UID" i3 >/dev/null; then
        fails=0
        sync_names
        # uma linha JSON por evento (focus, init, empty, rename, move...)
        i3-msg -t subscribe -m '["workspace"]' 2>/dev/null | while read -r _; do sync_names; done
    fi
    # i3 reiniciou ou ainda não subiu; desiste se a sessão X acabou
    ((++fails > 60)) && exit 0
    sleep 1
done
