#!/usr/bin/env bash
# i3-xfce-wsnames: keeps XFCE workspace names in sync with i3.
#
# xfsettingsd (workspaces.c) publishes _NET_DESKTOP_NAMES from xfconf
# xfwm4:/general/workspace_names and overwrites what i3 writes, so the
# panel pager would otherwise show "Workspace N". This service listens
# to i3 workspace events and copies the ordered list of names into that
# xfconf property; xfsettingsd then publishes the right names.
# Started by XFCE: ~/.config/autostart/i3-xfce-wsnames.desktop
set -uo pipefail

# Only runs when the session is using i3
[[ "${RICE_WM:-}" == "xfwm4" ]] && exit 0
pgrep -x -u "$UID" xfwm4 >/dev/null && exit 0

sync_names() {
    local args=() n
    while IFS= read -r n; do args+=(-t string -s "$n"); done < <(i3-msg -t get_workspaces | jq -r '.[].name')
    ((${#args[@]})) || return 0
    xfconf-query -c xfwm4 -p /general/workspace_names -n --force-array "${args[@]}"
}

fails=0
while :; do
    if pgrep -x -u "$UID" i3 >/dev/null; then
        fails=0
        sync_names
        # one JSON line per event (focus, init, empty, rename, move...)
        i3-msg -t subscribe -m '["workspace"]' 2>/dev/null | while read -r _; do sync_names; done
    fi
    # i3 restarted or hasn't started yet; give up if the X session ended
    ((++fails > 60)) && exit 0
    sleep 1
done
