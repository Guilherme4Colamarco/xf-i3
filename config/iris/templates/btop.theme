# iris -> btop. O iris-wall copia para ~/.config/btop/themes/iris.theme.
# Fundo vazio = usa o fundo do terminal (o kitty já está nas cores do iris).
theme[main_bg]=""
theme[main_fg]="{fg}"
theme[title]="{fg}"
theme[hi_fg]="{accent}"
theme[selected_bg]="{surface}"
theme[selected_fg]="{accent}"
theme[inactive_fg]="{dim}"
theme[graph_text]="{dim}"
theme[meter_bg]="{surface}"
theme[proc_misc]="{syntax_func}"
theme[cpu_box]="{dim}"
theme[mem_box]="{dim}"
theme[net_box]="{dim}"
theme[proc_box]="{dim}"
theme[div_line]="{surface}"
theme[temp_start]="{green}"
theme[temp_mid]="{yellow}"
theme[temp_end]="{red}"
theme[cpu_start]="{syntax_func}"
theme[cpu_mid]="{accent}"
theme[cpu_end]="{red}"
theme[free_start]="{green}"
theme[free_mid]="{green}"
theme[free_end]="{green}"
theme[cached_start]="{syntax_type}"
theme[cached_mid]="{syntax_type}"
theme[cached_end]="{syntax_type}"
theme[available_start]="{syntax_param}"
theme[available_mid]="{syntax_param}"
theme[available_end]="{syntax_param}"
theme[used_start]="{yellow}"
theme[used_mid]="{accent}"
theme[used_end]="{red}"
theme[download_start]="{syntax_func}"
theme[download_mid]="{accent}"
theme[download_end]="{red}"
theme[upload_start]="{syntax_keyword}"
theme[upload_mid]="{accent}"
theme[upload_end]="{red}"
theme[process_start]="{syntax_func}"
theme[process_mid]="{accent}"
theme[process_end]="{red}"
