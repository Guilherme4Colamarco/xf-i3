// fastfetch: layout minimalista para o setup CachyOS · XFCE + i3 (X11).
// As cores usam a paleta ANSI do terminal, que o iris-wall gera a partir do
// wallpaper (blue = accent, cyan = secundária, white = dim, default = fg).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "CachyOS_small",
    "color": {
      "1": "blue",
      "2": "cyan"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 8
    },
    "color": {
      "keys": "blue",
      "title": "default",
      "separator": "white"
    },
    "percent": {
      "type": 9,
      "color": {
        "green": "green",
        "yellow": "yellow",
        "red": "red"
      }
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{#1;title}{user-name}{#}{#separator}@{#}{#1;title}{host-name}{#}"
    },
    {
      "type": "separator",
      "string": "─"
    },
    {
      "type": "os",
      "key": "os"
    },
    {
      "type": "kernel",
      "key": "kernel",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "wm",
      "format": "{pretty-name} ({protocol-name})"
    },
    {
      "type": "shell",
      "key": "shell",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": "term",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "pkgs"
    },
    {
      "type": "cpu",
      "key": "cpu",
      "format": "{name} ({cores-logical})"
    },
    {
      "type": "gpu",
      "key": "gpu",
      "detectionMethod": "pci",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "mem",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "uptime",
      "key": "up",
      "format": "{?days}{days}d {?}{?hours}{hours}h {?}{minutes}m"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
